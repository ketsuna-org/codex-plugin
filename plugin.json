{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-plugin",
  "version": "0.1.3",
  "description": "Documentation officielle Bot Creator et exemples de commandes et workflows Blocks, BDFD et JavaScript.",
  "repository": "https://github.com/ketsuna-org/codex-plugin",
  "homepage": "https://bot-creator.fr",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Bot Creator",
        "shortDescription": "Guides et fonctions pour bots",
        "longDescription": "Consultez la documentation publique de Bot Creator et préparez des exemples de commandes et workflows. Cette version ne crée ni ne modifie de bots.",
        "websiteURL": "https://bot-creator.fr",
        "developerName": "Bot Creator",
        "category": "Productivity",
        "capabilities": [
